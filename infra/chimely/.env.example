# Only consumed by the Chimely container, NOT by DevFeed.
# Required: a dedicated Chimely database on PostgreSQL 15+.
# Format: postgres://USER:PASSWORD@HOST:5432/DATABASE
# Do not point this at the DevFeed application database.
DATABASE_URL=replace-me

# Optional: a Redis URL reachable by the container. Omit for one-instance
# development; Chimely falls back to PostgreSQL LISTEN/NOTIFY.
# REDIS_URL=replace-me

CHIMELY_LISTEN_ADDR=0.0.0.0:8080
CHIMELY_LOG_FORMAT=text
RUST_LOG=info
CHIMELY_ADMIN_EMAIL=replace-me
# At least 12 characters. Generate a unique secret; do not use replace-me.
CHIMELY_ADMIN_PASSWORD=replace-me
# false is for localhost-only HTTP development. Set true behind HTTPS.
CHIMELY_ADMIN_TLS_TERMINATED=false
# Must exceed DevFeed's 28-day maximum delivery/retry window.
CHIMELY_IDEMPOTENCY_RETENTION_DAYS=30
