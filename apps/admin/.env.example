# Required server-side origins. No OIDC secrets, database, or Redis credentials here.
# Example local values: http://127.0.0.1:8001 and http://localhost:3001
DEVFEED_ADMIN_API_URL=
DEVFEED_ADMIN_BASE_URL=
# For LAN development: comma-separated hostnames without schemes or ports.
# Restart the Next.js dev server after changing this setting.
# DEVFEED_ADMIN_DEV_ORIGINS=192.168.1.101
