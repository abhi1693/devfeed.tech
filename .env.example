# Required: set these explicitly. Missing or blank values prevent startup.
# Database and direct Redis connection settings.
# Point them at services you manage. For the full Compose stack, use compose.env.example instead.
# Containerized processes need hosts reachable from inside the container.
# Database URL format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# Redis URL format: redis://HOST:6379/0
DEVFEED_DATABASE_URL=
# Analytics maintenance and migrations require direct PostgreSQL or session pooling.
# Compose can use this override when application traffic uses transaction pooling.
# DEVFEED_DIRECT_DATABASE_URL=
DEVFEED_REDIS_URL=
# Enable only after schema 0040 and every article/image worker is upgraded.
# Existing publications stay live while a replacement runs privately.
DEVFEED_PUBLISHED_ARTICLE_REFRESH_ENABLED=false

# Required analytics store for Overview and operator boards. Prepare schemas and start the history importer.
# Compose supplies its internal URL; host-run processes need a reachable service origin.
DEVFEED_CLICKHOUSE_URL=http://localhost:8123
DEVFEED_CLICKHOUSE_DATABASE=devfeed
DEVFEED_CLICKHOUSE_USERNAME=devfeed
DEVFEED_CLICKHOUSE_PASSWORD=
DEVFEED_CLICKHOUSE_CONNECT_TIMEOUT_SECONDS=3
DEVFEED_CLICKHOUSE_TIMEOUT_SECONDS=30
DEVFEED_CLICKHOUSE_MAX_THREADS=2
DEVFEED_CLICKHOUSE_MAX_CONCURRENT_QUERIES=2
DEVFEED_CLICKHOUSE_MAX_EXECUTION_SECONDS=20
DEVFEED_CLICKHOUSE_MAX_MEMORY_BYTES=268435456
# Compose reserves independent ingestion capacity with a separate private account.
# Outside Compose, configure the importer's ClickHouse credentials for that account.
DEVFEED_CLICKHOUSE_INGEST_PASSWORD=change-me-ingest-password
# Each application role has a separate credential and scoped table access.
DEVFEED_CLICKHOUSE_PUBLIC_PASSWORD=change-me-public-password
DEVFEED_CLICKHOUSE_USER_PASSWORD=change-me-user-password
DEVFEED_CLICKHOUSE_PARTNER_PASSWORD=change-me-partner-password
DEVFEED_CLICKHOUSE_ADMIN_PASSWORD=change-me-admin-password
DEVFEED_CLICKHOUSE_WORKER_PASSWORD=change-me-worker-password
# Compose requires a generated reader password distinct from the operator and importer.
DEVFEED_CLICKHOUSE_READER_PASSWORD=change-me-reader-password
DEVFEED_CLICKHOUSE_READER_MAX_QUERIES=2
DEVFEED_CLICKHOUSE_READER_MAX_MEMORY_BYTES=536870912
DEVFEED_CLICKHOUSE_INGEST_MAX_QUERIES=3
DEVFEED_CLICKHOUSE_INGEST_MAX_MEMORY_BYTES=402653184
DEVFEED_CLICKHOUSE_SERVER_MAX_MEMORY_BYTES=1610612736
DEVFEED_CLICKHOUSE_SERVER_MAX_QUERIES=6
DEVFEED_CLICKHOUSE_SERVER_MAX_SELECTS=3
DEVFEED_CLICKHOUSE_SERVER_MAX_INSERTS=2
DEVFEED_ANALYTICS_BACKFILL_BATCH_SIZE=1000
DEVFEED_ANALYTICS_POLL_SECONDS=1
DEVFEED_ANALYTICS_BACKFILL_POLL_SECONDS=0.1
# Bounded current-state repair continues after the historical import completes.
DEVFEED_ANALYTICS_RECONCILE_BATCH_SIZE=100
DEVFEED_ANALYTICS_RECONCILE_POLL_SECONDS=30
DEVFEED_ANALYTICS_RECONCILE_SWEEP_SECONDS=300
# RQ work-horse completion only; API/global shutdown retains its five-second budget.
DEVFEED_ANALYTICS_WORKER_DRAIN_SECONDS=45
# Resource budget for analytics import and current-state reconciliation.
DEVFEED_ANALYTICS_IMPORTER_CPUS=0.5
DEVFEED_ANALYTICS_IMPORTER_MEMORY_LIMIT=512m

# Compose ClickHouse management UI (SQL editor, database/table explorer, dashboards).
# Sign in with your ClickHouse account; its password is never injected into the UI bundle.
# Publish on the LAN; use a specific interface address to restrict the binding.
DEVFEED_CH_UI_BIND_IP=0.0.0.0
DEVFEED_CH_UI_PORT=4000
DEVFEED_CH_UI_URL=http://localhost:4000
# Separate stable key for encrypted CH-UI sessions; generate with openssl rand -hex 32.
# Empty uses an automatically generated key persisted beside its SQLite database.
DEVFEED_CH_UI_SECRET_KEY=
DEVFEED_CH_UI_CPUS=0.5
DEVFEED_CH_UI_MEMORY_LIMIT=512m
# Optional Sentinel discovery; Redis URL supplies data auth, TLS and logical DB.
# DEVFEED_REDIS_SENTINEL_NODES=[["sentinel.example",26379]]
# DEVFEED_REDIS_SENTINEL_MASTER=valkey
# DEVFEED_REDIS_SENTINEL_USERNAME=
# DEVFEED_REDIS_SENTINEL_PASSWORD=
# DEVFEED_REDIS_SENTINEL_SSL=false
# PgBouncer owns reuse by default: APIs and workers close idle client sockets.
# Direct PostgreSQL deployments can explicitly opt in to local pooling.
# DEVFEED_DATABASE_POOL_ENABLED=false
# HTTP admission is independent of connection reuse; excess work gets 503 + Retry-After.
# Staged production uses 16 public / 8 private requests per process; defaults are 16/32.
# DEVFEED_API_MAX_CONCURRENT_REQUESTS=16
# DEVFEED_API_MAX_CONCURRENT_STREAMS=32
# Bounded pool waits (only when local pooling is explicitly enabled) and detection of lost database/pooler TCP connections.
# DEVFEED_DATABASE_POOL_TIMEOUT_SECONDS=2
# DEVFEED_DATABASE_POOL_RECYCLE_SECONDS=300
# DEVFEED_DATABASE_CONNECT_TIMEOUT_SECONDS=3
# DEVFEED_DATABASE_KEEPALIVES_IDLE_SECONDS=5
# DEVFEED_DATABASE_KEEPALIVES_INTERVAL_SECONDS=2
# DEVFEED_DATABASE_KEEPALIVES_COUNT=2
# DEVFEED_DATABASE_TCP_USER_TIMEOUT_MS=8000

# Retain successful superseded analysis input payloads for 30 days.
# Latest jobs, current provenance and pending reviews are protected.
DEVFEED_JOB_PAYLOAD_RETENTION_DAYS=30
DEVFEED_JOB_PAYLOAD_PRUNE_BATCH_SIZE=100
DEVFEED_JOB_PAYLOAD_SCAN_BATCH_SIZE=1000
DEVFEED_JOB_PAYLOAD_PAGE_INTERVAL_SECONDS=30
DEVFEED_JOB_PAYLOAD_SWEEP_INTERVAL_SECONDS=3600

# Optional application settings.
# Reader runtime flag: also disables GA4 when testing a production build locally.
DEVFEED_ANALYTICS_ENABLED=false
# GOOGLE_ANALYTICS_ID=G-N4V5CW5C0M
# Extension GA4 uses the website property through a server-only Measurement Protocol secret.
DEVFEED_EXTENSION_ANALYTICS_ENABLED=false
MICROSOFT_CLARITY_PROJECT_ID=
# X pc5f8: opt in to server signup conversions and first-party click attribution.
DEVFEED_X_PIXEL_ENABLED=false
# Server-only credentials and completed sign-up event from Events Manager.
X_PIXEL_TOKEN=
X_SIGNUP_EVENT_ID=tw-pc5f8-rgbo7
# DEVFEED_EXTENSION_GA_API_SECRET=
DEVFEED_CORS_ORIGINS=[]
# Optional additional reader origins trusted for CSRF-protected writes (web + user-api).
# Keep the registered sign-in callback at DEVFEED_USER_BASE_URL; list LAN aliases explicitly.
# DEVFEED_USER_ALLOWED_ORIGINS=[]
# Optional trusted Chrome extension IDs for user-session mutations (web + user-api).
# DEVFEED_USER_EXTENSION_IDS=["hliakjocndflpkmfajndigbpngfcekdm"]
# Runtime logging.
DEVFEED_LOG_LEVEL=INFO
DEVFEED_LOG_FORMAT=text
# Per-run runtime log retention in the same Redis (independent of the GET cache).
DEVFEED_JOB_LOG_MAX_ENTRIES=1000
DEVFEED_JOB_LOG_TTL_SECONDS=604800
DEVFEED_FEED_USER_AGENT=DevFeed/0.1 (+https://devfeed.tech)
# Bounds for background HTML image metadata lookups (not image downloads).
DEVFEED_PAGE_MAX_BYTES=2000000
# Article HTML can include large scripts; extraction still retains at most 60,000 characters.
DEVFEED_ARTICLE_PAGE_MAX_BYTES=10000000
# Source homepages can also contain large scripts and embedded application data.
DEVFEED_SOURCE_PAGE_MAX_BYTES=10000000
DEVFEED_PAGE_TIMEOUT_SECONDS=15
# Enable durable solver handoffs only with a dedicated `worker --queue solver`.
DEVFEED_SOLVER_QUEUE_ENABLED=false
DEVFEED_SOLVER_TIMEOUT_SECONDS=45
# Per-queue publication batch. Partner queues refill every second up to two waiting batches.
DEVFEED_SCHEDULER_BATCH_SIZE=100
# Set only on the solver worker; provider origins must be trusted and network-isolated.
DEVFEED_SOLVER_SERVICES=[]
# Example: [{"provider":"flaresolverr","url":"http://solver:8191","timeout_seconds":30}]

# Server-side GET caching uses DEVFEED_REDIS_URL; no additional connection URL.
DEVFEED_CACHE_ENABLED=true
DEVFEED_CACHE_TTL_SECONDS=300
DEVFEED_CACHE_METADATA_TTL_SECONDS=600
DEVFEED_CACHE_PUBLIC_PROFILE_TTL_SECONDS=21600
DEVFEED_CACHE_MAX_BYTES=1000000

# AI is opt-in. No endpoint, model, or credentials are assumed.
# Set these before enabling AI. ws is only accepted on loopback; remote use needs wss + token.
DEVFEED_AI_ENABLED=false
# Inclusive UTC source publication date; undated content is deferred. Empty disables.
# Move earlier or clear later to resume older content; topic research is unaffected.
DEVFEED_AI_CONTENT_NOT_BEFORE=
# Automatically approve validated proposals after successful AI research.
# Independent, app-wide policies; false keeps the manual review step.
DEVFEED_AUTO_APPROVE_TOPICS=false
DEVFEED_AUTO_APPROVE_TOPIC_RELATIONSHIPS=false
# Trusted imports request research; relevant active-topic changes revisit pending articles.
DEVFEED_AUTO_RESEARCH_IMPORTS=false
DEVFEED_AUTO_RESEARCH_TOPIC_BRANDING=false
DEVFEED_AUTO_REANALYZE_TOPICS=false
DEVFEED_AUTO_RESEARCH_RELATIONSHIPS=false
# Exact name/slug/alias tag links run without AI; manual choices are preserved.
DEVFEED_AUTO_LINK_TAGS=true
DEVFEED_RELATIONSHIP_RESEARCH_BATCH_SIZE=100
DEVFEED_RELATIONSHIP_RESEARCH_MAX_PENDING=4
DEVFEED_AUTOMATION_BATCH_SIZE=50
# Preserve source evidence and UUIDs while compacting article prompt JSON.
DEVFEED_AI_COMPACT_ARTICLE_PROMPTS=false
# Enable after reviewing a topic workflow benchmark. Bounded topics also enables tiered routing.
DEVFEED_AI_TIERED_ROUTING_ENABLED=false
DEVFEED_AI_BOUNDED_TOPICS_ENABLED=false
DEVFEED_AI_FAST_MODEL=gpt-6-luna
DEVFEED_AI_RESEARCH_MODEL=gpt-6-luna
DEVFEED_AI_ESCALATION_MODEL=gpt-6-sol
DEVFEED_TOPIC_DECISION_MAX_CALLS=5
DEVFEED_TOPIC_DECISION_MAX_TOKENS=64000
DEVFEED_TOPIC_DECISION_CALL_TOKENS=40000
DEVFEED_TOPIC_DECISION_MAX_SEARCHES=4
DEVFEED_TOPIC_DECISION_MAX_SECONDS=240
DEVFEED_TOPIC_EVIDENCE_MAX_AGE_SECONDS=86400
DEVFEED_TOPIC_DECISION_MAX_PENDING=8
DEVFEED_TOPIC_DECISION_WORKER_BUFFER=2
DEVFEED_TOPIC_EVIDENCE_CONCURRENCY=3
DEVFEED_TOPIC_EVIDENCE_REUSE_SECONDS=300
DEVFEED_RELATIONSHIP_PAUSE_FOR_TOPIC_BACKLOG=true
DEVFEED_RELATIONSHIP_DAILY_CALL_BUDGET=40
# Per topic/tag shortlist. A small fallback retains candidates without lexical matches.
DEVFEED_ANALYSIS_MAX_CANDIDATES=80
DEVFEED_ANALYSIS_FALLBACK_CANDIDATES=8
# Retain one revision-checked catalog/index through each job, including inference waits.
# Opt in after measuring worker peak memory on a representative catalog.
DEVFEED_ANALYSIS_CATALOG_REUSE_ENABLED=false
# Shared provider cooldown; a later reported reset extends this delay.
DEVFEED_AI_CAPACITY_COOLDOWN_SECONDS=300
# Transient server overload is separate from account quota/rate resets.
DEVFEED_AI_SERVER_OVERLOAD_COOLDOWN_SECONDS=30
# Total public-page verification budget, separate from the inference timeout.
DEVFEED_EVIDENCE_TIMEOUT_SECONDS=45
# DEVFEED_CODEX_APP_SERVER_URL=
# DEVFEED_CODEX_MODEL=
# DEVFEED_CODEX_AUTH_TOKEN=
DEVFEED_CODEX_TIMEOUT_SECONDS=90

# Notification infrastructure is shared by the admin and user app.
# These are Chimely inbox isolation spaces, NOT separate dev/prod deployments.
# The common RQ workers use the API keys; each app API uses only its HMAC secret.
DEVFEED_NOTIFICATIONS_ENABLED=false
DEVFEED_CHIMELY_API_URL=replace-me
DEVFEED_CHIMELY_ADMIN_ENVIRONMENT=replace-me
DEVFEED_CHIMELY_ADMIN_API_KEY=replace-me
DEVFEED_CHIMELY_ADMIN_HMAC_SECRET=replace-me
# Compose provisions this separate inbox space automatically.
DEVFEED_CHIMELY_USER_ENVIRONMENT=devfeed-users
# DEVFEED_CHIMELY_USER_API_KEY=replace-me
# DEVFEED_CHIMELY_USER_HMAC_SECRET=replace-me

# Admin API only. Public API and workers do not load these OIDC settings.
# URLs and client IDs must be supplied, never copied from another app registration.
# Configure a dedicated OIDC application with authorization-code + PKCE S256.
# DEVFEED_ADMIN_BASE_URL=https://admin.example.com
# DEVFEED_OIDC_ISSUER_URL=https://identity.example.com
# DEVFEED_OIDC_CLIENT_ID=
# DEVFEED_OIDC_ORGANIZATION_ID=
DEVFEED_ADMIN_REQUIRED_ROLE=superuser
DEVFEED_OIDC_ROLES_CLAIM=urn:zitadel:iam:org:project:roles
DEVFEED_OIDC_ROLES_FORMAT=organization_map
DEVFEED_OIDC_ROLE_SCOPE_TEMPLATE=urn:zitadel:iam:org:project:role:{role}
DEVFEED_ADMIN_COOKIE_SECURE=true
DEVFEED_ADMIN_SESSION_TTL_SECONDS=28800
DEVFEED_OIDC_TOKEN_ENDPOINT_AUTH_METHOD=none
DEVFEED_OIDC_SCOPES=["openid","profile","email"]
# Only secret-authenticated clients need this; PKCE is always used either way.
# DEVFEED_OIDC_CLIENT_SECRET=
# Zitadel defaults; change these two for another provider's organization semantics.
DEVFEED_OIDC_ORGANIZATION_SCOPE_TEMPLATE=urn:zitadel:iam:org:id:{organization_id}
DEVFEED_OIDC_ORGANIZATION_CLAIM=urn:zitadel:iam:user:resourceowner:id

# Optional Typesense search. Start Compose with --profile search after enabling.
# Use two different random secrets; only the indexer receives the write key.
DEVFEED_SEARCH_ENABLED=false
DEVFEED_SEARCH_URL=http://typesense:8108
DEVFEED_SEARCH_COLLECTION_PREFIX=devfeed
DEVFEED_SEARCH_COLLECTION_VERSION=v1
DEVFEED_SEARCH_ADMIN_KEY=
DEVFEED_SEARCH_QUERY_KEY=
# Bounded per-process HTTP connections to Typesense; independent of PgBouncer.
DEVFEED_SEARCH_HTTP_MAX_CONNECTIONS=32
DEVFEED_SEARCH_HTTP_POOL_TIMEOUT_SECONDS=2
DEVFEED_SEARCH_INDEX_BATCH_SIZE=200
# Search-indexer retries are bounded and apply only to transient 503/network/import failures.
# Write timeout adapts upward from this value using observed successful import duration.
# DEVFEED_SEARCH_INDEX_RETRY_ATTEMPTS=3
# DEVFEED_SEARCH_INDEX_RETRY_BASE_SECONDS=1
# DEVFEED_SEARCH_INDEX_RETRY_MAX_SECONDS=30
# DEVFEED_SEARCH_INDEX_WRITE_TIMEOUT_SECONDS=60
# DEVFEED_SEARCH_INDEX_WRITE_TIMEOUT_MAX_SECONDS=600
# DEVFEED_SEARCH_RECONCILE_INTERVAL_SECONDS=60
# DEVFEED_SEARCH_SUGGESTION_MIN_VOLUME=5

# Shared crawler inventory refresh; independent from reader-cache invalidation.
DEVFEED_SITEMAP_REFRESH_SECONDS=900
DEVFEED_SITEMAP_RETENTION_SECONDS=86400


# Optional dedicated Compose workers: enable COMPOSE_PROFILES=workers (or ai,workers
# for the bundled Codex server). See docs/worker-queues.md before changing topology.
# DEVFEED_ARTICLE_ANALYSIS_WORKER_REPLICAS=1
# DEVFEED_TOPIC_ANALYSIS_WORKER_REPLICAS=1
# DEVFEED_RESEARCH_VERIFICATION_WORKER_REPLICAS=1
# DEVFEED_SOURCE_ANALYSIS_WORKER_REPLICAS=1
# DEVFEED_RELATIONSHIPS_WORKER_REPLICAS=1
# DEVFEED_NOTIFICATIONS_WORKER_REPLICAS=1
# DEVFEED_INGESTION_WORKER_REPLICAS=1
# DEVFEED_ARTICLE_ENRICHMENT_WORKER_REPLICAS=1
# DEVFEED_SOURCE_ENRICHMENT_WORKER_REPLICAS=1
# DEVFEED_IMAGES_WORKER_REPLICAS=1

# Optional operational telemetry. Production enables these per container via GitOps.
# Never publish/map port 9100 to the public network; one listener per process/container.
DEVFEED_METRICS_ENABLED=false
DEVFEED_METRICS_HOST=127.0.0.1
DEVFEED_METRICS_PORT=9100
DEVFEED_TELEMETRY_ENVIRONMENT=development
# HTTP/protobuf base URL; exports /v1/traces and /v1/metrics.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector.internal:4318
# DEVFEED_OTLP_ENDPOINT overrides the standard endpoint when set.
# OTEL_EXPORTER_OTLP_HEADERS=api-key=replace-with-secret-manager-value
# OTEL_SDK_DISABLED=true
DEVFEED_TRACE_SAMPLE_RATIO=0.1
# DEVFEED_PYROSCOPE_SERVER=http://pyroscope.internal:4040
DEVFEED_PROFILING_SAMPLE_RATE=19
# Frontend runtime settings.
# Full public MCP ingress URL advertised by the reader and extensions.
# Leave unset until a server is available; no URL is guessed from the website host.
# DEVFEED_MCP_PUBLIC_URL=https://mcp.example.com/mcp
# Optional server-only MCP transport URL for reader discovery behind a private network.
# With the Compose mcp profile, use http://mcp:8003/mcp; start that service separately.
# DEVFEED_MCP_INTERNAL_URL=http://mcp:8003/mcp
# DEVFEED_VERSION is set to the immutable release version in production.

# Optional shared-account pacing: requires a ChatGPT weekly quota and scheduler.
# Disabled uses the existing fixed relationship call budget instead.
DEVFEED_AI_QUOTA_PACING_ENABLED=false
DEVFEED_AI_QUOTA_RESERVE_PERCENT=20

# Image storage: credentials stay in the images worker and private APIs for
# avatar, ad and connection-logo uploads.
# Public reader APIs and frontends use only the public URL.
# Enable the `images` Compose profile for imgproxy and the dedicated Images worker.
# Topic logos require public GET/HEAD CORS for card exports; see apps/aggregator/TOPIC_LOGOS.md.
DEVFEED_IMAGE_STORAGE_ENABLED=false
DEVFEED_IMAGE_STORAGE_ENDPOINT=https://492e25f5f18ef59e38763f58a78362f7.r2.cloudflarestorage.com
DEVFEED_IMAGE_STORAGE_BUCKET=devfeed-images-dev
DEVFEED_IMAGE_PUBLIC_URL=https://pub-5902d9886c3d4a00beeba906c0cbe154.r2.dev
DEVFEED_IMAGE_STORAGE_ACCESS_KEY=
DEVFEED_IMAGE_STORAGE_SECRET_KEY=
DEVFEED_IMGPROXY_URL=http://imgproxy:8080
# Generate separate hex secrets (openssl rand -hex 32). Never expose in frontend config.
DEVFEED_IMGPROXY_KEY=
DEVFEED_IMGPROXY_SALT=
DEVFEED_IMAGE_MAX_BYTES=10000000

# Pause new and pending article-derived topic proposals independently of full automation.
DEVFEED_ARTICLE_TOPIC_PROPOSALS_ENABLED=true

# Shared GitHub/Google identity provider IDs for reader and admin sign-in.
# Enable these providers for both OIDC applications; their client IDs remain separate.
# Without provider IDs, sign-in opens the hosted organization page.
# DEVFEED_OIDC_GITHUB_IDP_ID=
# DEVFEED_OIDC_GOOGLE_IDP_ID=

# Optional signed-in MCP endpoint (all five settings are required together).
# Reader OIDC sign-in must already be configured; MCP and user-api share Redis.
# DEVFEED_MCP_USER_API_URL=http://user-api:8002
# Use the same DEVFEED_MCP_PUBLIC_URL configured above for OAuth.
# DEVFEED_MCP_OAUTH_ISSUER_URL=https://mcp.example.com
# Reader base URL for browser visits to /mcp and OAuth sign-in.
# Can also be set without enabling account tools.
# DEVFEED_MCP_WEB_URL=https://devfeed.tech
# DEVFEED_MCP_REDIS_URL=redis://redis:6379/0

# Short-lived OAuth access with renewable, bounded account connections.
# DEVFEED_MCP_ACCESS_TOKEN_TTL_SECONDS=900
# DEVFEED_USER_MCP_SESSION_TTL_SECONDS=2592000
# DEVFEED_USER_MCP_SESSION_ABSOLUTE_TTL_SECONDS=7776000

# Opt in globally AND per source. Restart scheduler, workers, admin API and CLI processes.
DEVFEED_ADAPTIVE_SOURCE_POLLING_ENABLED=false
DEVFEED_ADAPTIVE_SOURCE_POLLING_MIN_SECONDS=300
DEVFEED_ADAPTIVE_SOURCE_POLLING_MAX_SECONDS=86400

# Partner portal: use a separate Zitadel application/client in the same project.
# The partner-api process reads the shared DEVFEED_OIDC_* policy settings;
# Compose maps these dedicated client values into that process only.
# DEVFEED_PARTNER_BASE_URL=https://partner.devfeed.tech
# DEVFEED_PARTNER_API_URL=http://partner-api:8004
# DEVFEED_PARTNER_PORT=3002
# DEVFEED_PARTNER_COOKIE_SECURE=true
# DEVFEED_PARTNER_SESSION_TTL_SECONDS=28800
# DEVFEED_PARTNER_OIDC_CLIENT_ID=
# DEVFEED_PARTNER_OIDC_CLIENT_SECRET=

# Server-only receipt signing key shared by the public API and user API delivery code.
# Use at least 32 random ASCII characters. Never expose this key to the reader or extensions.
# An empty key disables delivery and collection. See packages/core/PARTNER_PROMOTIONS.md.
DEVFEED_PARTNER_TRACKING_KEY=

# Dedicated server-only key shared by web and public API for caller quota isolation.
# Use at least 32 random ASCII characters; never reuse the receipt signing key.
DEVFEED_PARTNER_CALLER_KEY=
# Enable only behind an edge that overwrites this single-IP header and restricts origin access.
# Cloudflare Tunnel deployments can use cf-connecting-ip. Leave unset for direct development.
DEVFEED_PARTNER_CALLER_IP_HEADER=

# Encryption key for write-only import credentials stored per connection in the DB.
# Enter each API token in the import connection form. Generate a Fernet key
# with cryptography.fernet.Fernet.generate_key(); keep it separate from the DB.
# Inject the same key into admin-api, partner-api and import workers. Missing configuration
# disables token setup; replacing the key requires replacing saved credentials.
DEVFEED_PARTNER_CREDENTIAL_KEY=

# Per-kind queue routing overrides; high/default/low are the default transport.
# Per-kind overrides also cover the kind's fresh lane unless explicitly overridden.
# DEVFEED_JOB_QUEUE_OVERRIDES={"article-analysis":"article-analysis","notifications":"low"}
# Images and solver destinations must remain exclusive to preserve credential isolation.
DEVFEED_HIGH_WORKER_REPLICAS=4
DEVFEED_DEFAULT_WORKER_REPLICAS=4
DEVFEED_LOW_WORKER_REPLICAS=1
