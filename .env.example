# Required: set these explicitly. Missing or blank values prevent startup.
# These URLs are the only database/Redis connection settings.
# Point them at services you manage. For the full Compose stack, use compose.env.example instead.
# Containerized processes need hosts reachable from inside the container.
# Database URL format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# Redis URL format: redis://HOST:6379/0
DEVFEED_DATABASE_URL=
DEVFEED_REDIS_URL=

# Optional application settings.
DEVFEED_CORS_ORIGINS=[]
DEVFEED_LOG_LEVEL=INFO
DEVFEED_LOG_FORMAT=text
# Per-run runtime log retention in the same Redis (independent of the GET cache).
DEVFEED_JOB_LOG_MAX_ENTRIES=1000
DEVFEED_JOB_LOG_TTL_SECONDS=604800
DEVFEED_FEED_USER_AGENT=DevFeed/0.1 (+https://devfeed.tech)
# Bounds for background HTML image metadata lookups (not image downloads).
DEVFEED_PAGE_MAX_BYTES=2000000
# Article HTML can include large scripts; extraction still retains at most 60,000 characters.
DEVFEED_ARTICLE_PAGE_MAX_BYTES=10000000
# Source homepages can also contain large scripts and embedded application data.
DEVFEED_SOURCE_PAGE_MAX_BYTES=10000000
DEVFEED_PAGE_TIMEOUT_SECONDS=15
# Server-side GET caching uses DEVFEED_REDIS_URL; no additional connection URL.
DEVFEED_CACHE_ENABLED=true
DEVFEED_CACHE_TTL_SECONDS=300
DEVFEED_CACHE_METADATA_TTL_SECONDS=600
DEVFEED_CACHE_MAX_BYTES=1000000

# AI is opt-in. No endpoint, model, or credentials are assumed.
# Set these before enabling AI. ws is only accepted on loopback; remote use needs wss + token.
DEVFEED_AI_ENABLED=false
# Automatically approve validated proposals after successful AI research.
# Independent, app-wide policies; false keeps the manual review step.
DEVFEED_AUTO_APPROVE_TOPICS=false
DEVFEED_AUTO_APPROVE_TOPIC_RELATIONSHIPS=false
# Trusted imports request research; relevant active-topic changes revisit pending articles.
DEVFEED_AUTO_RESEARCH_IMPORTS=false
DEVFEED_AUTO_REANALYZE_TOPICS=false
DEVFEED_AUTO_RESEARCH_RELATIONSHIPS=false
# Exact name/slug/alias tag links run without AI; manual choices are preserved.
DEVFEED_AUTO_LINK_TAGS=true
DEVFEED_RELATIONSHIP_RESEARCH_BATCH_SIZE=100
DEVFEED_RELATIONSHIP_RESEARCH_MAX_PENDING=4
DEVFEED_AUTOMATION_BATCH_SIZE=50
# Per topic/tag shortlist. A small fallback retains candidates without lexical matches.
DEVFEED_ANALYSIS_MAX_CANDIDATES=80
DEVFEED_ANALYSIS_FALLBACK_CANDIDATES=8
# Shared provider cooldown; a later reported reset extends this delay.
DEVFEED_AI_CAPACITY_COOLDOWN_SECONDS=300
# Total public-page verification budget, separate from the inference timeout.
DEVFEED_EVIDENCE_TIMEOUT_SECONDS=45
# DEVFEED_CODEX_APP_SERVER_URL=
# DEVFEED_CODEX_MODEL=
# DEVFEED_CODEX_AUTH_TOKEN=
DEVFEED_CODEX_TIMEOUT_SECONDS=90

# Notification infrastructure is shared by the admin and future user app.
# These are Chimely inbox isolation spaces, NOT separate dev/prod deployments.
# The common RQ workers use the API keys; each app API uses only its HMAC secret.
DEVFEED_NOTIFICATIONS_ENABLED=false
DEVFEED_CHIMELY_API_URL=replace-me
DEVFEED_CHIMELY_ADMIN_ENVIRONMENT=replace-me
DEVFEED_CHIMELY_ADMIN_API_KEY=replace-me
DEVFEED_CHIMELY_ADMIN_HMAC_SECRET=replace-me
# Leave the user destination unset until its Chimely space is provisioned.
# DEVFEED_CHIMELY_USER_ENVIRONMENT=replace-me
# DEVFEED_CHIMELY_USER_API_KEY=replace-me
# DEVFEED_CHIMELY_USER_HMAC_SECRET=replace-me

# Admin API only. Public API and workers do not load these OIDC settings.
# URLs and client IDs must be supplied, never copied from another app registration.
# Configure a dedicated OIDC application with authorization-code + PKCE S256.
# DEVFEED_ADMIN_BASE_URL=https://admin.example.com
# DEVFEED_OIDC_ISSUER_URL=https://identity.example.com
# DEVFEED_OIDC_CLIENT_ID=
# DEVFEED_OIDC_ORGANIZATION_ID=
DEVFEED_ADMIN_REQUIRED_ROLE=superuser
DEVFEED_OIDC_ROLES_CLAIM=urn:zitadel:iam:org:project:roles
DEVFEED_OIDC_ROLES_FORMAT=organization_map
DEVFEED_OIDC_ROLE_SCOPE_TEMPLATE=urn:zitadel:iam:org:project:role:{role}
DEVFEED_ADMIN_COOKIE_SECURE=true
DEVFEED_ADMIN_SESSION_TTL_SECONDS=28800
DEVFEED_OIDC_TOKEN_ENDPOINT_AUTH_METHOD=none
DEVFEED_OIDC_SCOPES=["openid","profile","email"]
# Only secret-authenticated clients need this; PKCE is always used either way.
# DEVFEED_OIDC_CLIENT_SECRET=
# Zitadel defaults; change these two for another provider's organization semantics.
DEVFEED_OIDC_ORGANIZATION_SCOPE_TEMPLATE=urn:zitadel:iam:org:id:{organization_id}
DEVFEED_OIDC_ORGANIZATION_CLAIM=urn:zitadel:iam:user:resourceowner:id
