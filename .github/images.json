{
  "schema-version": 1,
  "images": [
    {
      "id": "backend",
      "image": "ghcr.io/abhi1693/devfeed.tech/backend",
      "context": ".",
      "file": "Dockerfile",
      "platforms": [
        "linux/arm64"
      ],
      "smoke-script": ".github/scripts/smoke-image.sh"
    },
    {
      "id": "article-enrichment-worker",
      "image": "ghcr.io/abhi1693/devfeed.tech/article-enrichment-worker",
      "context": ".",
      "file": "Dockerfile",
      "build-args": {
        "DEVFEED_PACKAGE_ARGS": "--package devfeed-article-enrichment-worker"
      },
      "paths": [
        "Dockerfile",
        ".dockerignore",
        "pyproject.toml",
        "uv.lock",
        ".python-version",
        "packages/core/**",
        "packages/http/**",
        "apps/aggregator/**",
        "apps/notifications/**",
        "apps/article-enrichment-worker/**"
      ],
      "platforms": [
        "linux/arm64"
      ],
      "smoke-script": ".github/scripts/smoke-image.sh"
    },
