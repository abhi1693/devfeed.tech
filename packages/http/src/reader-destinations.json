{
  "version": 1,
  "maxLength": 4096,
  "parameters": {
    "articleSlug": {
      "pattern": "[a-zA-Z0-9][a-zA-Z0-9-]*",
      "minLength": 1,
      "maxLength": 200
    },
    "topicSlug": {
      "pattern": "[a-zA-Z0-9][a-zA-Z0-9-]*",
      "minLength": 1,
      "maxLength": 100
    },
    "sourceSlug": {
      "pattern": "[a-zA-Z0-9][a-zA-Z0-9-]*",
      "minLength": 1,
      "maxLength": 200
    },
    "tag": {
      "minLength": 1,
      "maxLength": 100,
      "noSeparators": true
    },
    "username": {
      "pattern": "[a-zA-Z0-9][a-zA-Z0-9_-]*[a-zA-Z0-9]",
      "minLength": 3,
      "maxLength": 30
    },
    "contentType": {
      "values": {
        "article": "articles",
        "news": "news",
        "tutorial": "tutorials",
        "release": "releases",
        "comparison": "comparisons",
        "opinion": "opinions"
      }
    },
    "settings": {
      "values": {
        "profile": "profile",
        "appearance": "appearance",
        "feed": "feed",
        "notifications": "notifications",
        "topics": "topics",
        "sources": "sources"
      }
    }
  },
  "queryFields": {
    "q": {
      "maxLength": 200
    },
    "topic": {
      "maxLength": 100
    },
    "tag": {
      "maxLength": 100
    },
    "cursor": {
      "maxLength": 300
    },
    "contentType": {
      "values": ["article", "news", "tutorial", "release", "comparison", "opinion"]
    },
    "feedSort": {
      "values": ["newest", "oldest", "most_liked", "recommended"]
    },
    "searchSort": {
      "values": ["relevance", "newest", "oldest"]
    },
    "sourceId": {
      "pattern": "[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}"
    },
    "searchSection": {
      "values": ["articles", "topics", "sources", "tags"]
    },
    "date": {
      "format": "date"
    },
    "offset": {
      "format": "integer",
      "min": 0,
      "max": 1000000
    },
    "request": {
      "pattern": "[A-Za-z0-9_-]{43}"
    }
  },
  "queryProfiles": {
    "none": {
      "fields": {}
    },
    "feed": {
      "fields": {
        "q": "q",
        "topic": "topic",
        "content_type": "contentType",
        "source_id": "sourceId",
        "tag": "tag",
        "cursor": "cursor",
        "sort": "feedSort"
      }
    },
    "search": {
      "fields": {
        "q": "q",
        "section": "searchSection",
        "content_types": "contentType",
        "sort": "searchSort",
        "date_from": "date",
        "date_to": "date"
      }
    },
    "cursor": {
      "fields": {
        "cursor": "cursor"
      }
    },
    "catalog": {
      "fields": {
        "offset": "offset"
      }
    },
    "mcpAuthorization": {
      "fields": {
        "request": "request"
      },
      "required": ["request"]
    }
  },
